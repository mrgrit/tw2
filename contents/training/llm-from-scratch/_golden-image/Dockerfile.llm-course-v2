# 수업용 골든 이미지 llm-course:v2
#
# 교재 1주차 P1-4가 요구하는 "골든 이미지"의 구현체.
# 기준 환경: NVIDIA DGX Spark (GB10 / Grace Blackwell / aarch64 / CUDA 13 / 통합 메모리 128GB)
#
# 설계 근거:
#  - base: nvidia/cuda:13.0.1-runtime-ubuntu24.04 → 호스트 드라이버 580.x / CUDA 13.0 과 정합
#  - Ubuntu 24.04 의 시스템 python 이 3.12 → torch cu130 cp312 휠과 정확히 일치
#  - torch 는 반드시 cu130 인덱스에서 받는다. PyPI 기본 휠은 GB10(sm_121) 커널이 없다.
#  - base 도 torch cu130 휠도 arm64/amd64 양쪽에 존재한다. 즉 이 Dockerfile 은
#    DGX Spark(aarch64) 와 일반 x86 + RTX 장비 양쪽에서 그대로 빌드된다.
#
# v1 → v2 변경 (2026-08-09, 실환경 검증에서 드러난 결손을 메움):
#  1. safetensors / huggingface_hub 추가 — 없으면 W10 "OpenAI 가중치 이식" 이 실행 불가였다
#  2. 전 패키지 버전 고정 — 교재 통과 기준이 수치라 버전이 흔들리면 정답지가 무너진다
#  3. tiktoken BPE 캐시를 이미지에 구움 — 폐쇄망 실습실에서 W02 가 첫 줄에서 막히던 문제
#  4. matplotlib 폰트 캐시를 구움 — 매 컨테이너마다 "building the font cache" 지연 제거
#  5. HF_HOME 을 /work 아래로 — 컨테이너를 다시 만들어도 548MB/1.5GB 를 재다운로드하지 않음
#  6. verify-env 내장 + 빌드타임 자체검사 — 깨진 이미지는 애초에 태그가 붙지 않는다
#
# 빌드:  docker build -f harness/Dockerfile.llm-course-v2 -t llm-course:v2 harness/
# 검증:  docker run --rm --gpus all llm-course:v2 verify-env

FROM nvidia/cuda:13.0.1-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        git curl wget ca-certificates \
        build-essential pkg-config \
        vim less procps \
        fonts-nanum fonts-nanum-coding fontconfig \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/*

# 1) torch — CUDA 13.0 전용 인덱스 (aarch64 + sm_121 지원)
RUN pip install --index-url https://download.pytorch.org/whl/cu130 \
        torch==2.9.1+cu130

# 2) 실습 의존성 — 전량 버전 고정. 근거는 requirements.txt 주석 참조.
COPY requirements.txt /opt/llm-course/requirements.txt
RUN pip install -r /opt/llm-course/requirements.txt

# 3) matplotlib 한글 라벨이 □ 로 깨지지 않게 기본 폰트를 NanumGothic 으로 고정.
#    (교재의 그래프 미션은 4·6·9·10·11·13주차에 한글 제목·축 라벨을 요구한다)
#    패키지 기본 matplotlibrc 를 수정하면 Duplicate key 경고가 나므로 별도 파일 + MATPLOTLIBRC.
RUN mkdir -p /opt/mplconfig && printf '%s\n' \
        'backend: Agg' \
        'font.family: NanumGothic' \
        'axes.unicode_minus: False' \
        'figure.dpi: 110' \
    > /opt/mplconfig/matplotlibrc
ENV MATPLOTLIBRC=/opt/mplconfig/matplotlibrc \
    MPLCONFIGDIR=/opt/mplcache

# 폰트 캐시를 빌드 시점에 구워 둔다. 안 그러면 학생마다 첫 그래프에서
# "Matplotlib is building the font cache" 로 수십 초를 버린다.
RUN mkdir -p /opt/mplcache \
    && python3 -c "import matplotlib; matplotlib.use('Agg'); \
import matplotlib.pyplot as plt; f,a=plt.subplots(); a.set_title('훈련 손실'); f.savefig('/tmp/_w.png')" \
    && rm -f /tmp/_w.png \
    && chmod -R 777 /opt/mplcache

# 4) tiktoken BPE 사전을 이미지에 굽는다.
#    tiktoken 은 gpt2 인코딩을 첫 호출에 openaipublic.blob.core.windows.net 에서 받아온다.
#    폐쇄망 실습실이면 W02 미션 1이 첫 줄에서 죽는다. 여기서 미리 받아 캐시에 넣어 둔다.
ENV TIKTOKEN_CACHE_DIR=/opt/tiktoken_cache
RUN mkdir -p /opt/tiktoken_cache \
    && python3 -c "import tiktoken; e=tiktoken.get_encoding('gpt2'); assert e.n_vocab==50257" \
    && chmod -R a+rX /opt/tiktoken_cache

# 5) huggingface 캐시를 마운트 볼륨 아래로 옮긴다.
#    기본값(/root/.cache)에 두면 컨테이너를 다시 만들 때마다 W10 의 548MB/1520MB 를
#    다시 받아야 한다. /work 는 호스트 마운트라 컨테이너 수명과 무관하게 살아남는다.
ENV HF_HOME=/work/.hf-cache

# 6) 검증 스크립트 — 새 장비 배포 직후 `docker run --rm --gpus all llm-course:v2 verify-env`
COPY verify-env.py /opt/llm-course/verify-env.py
RUN printf '#!/bin/sh\nexec python3 /opt/llm-course/verify-env.py "$@"\n' \
        > /usr/local/bin/verify-env \
    && chmod +x /usr/local/bin/verify-env

# 7) 빌드타임 자체검사. 여기서 실패하면 이미지가 아예 나오지 않는다.
#    빌드 중에는 GPU 가 붙지 않으므로 GPU 항목만 건너뛴다 (런타임 verify-env 가 검사).
#    /work 는 빌드 시점엔 마운트 전이라 미리 만들어 둔다.
RUN mkdir -p /work && python3 /opt/llm-course/verify-env.py --no-gpu

# 8) 실제로 설치된 전 패키지 스냅샷 — 다른 장비에서 완전히 동일하게 재현할 때 쓴다.
RUN pip freeze > /opt/llm-course/requirements.lock

LABEL org.opencontainers.image.title="llm-course" \
      org.opencontainers.image.version="v2" \
      org.opencontainers.image.description="밑바닥부터 만들면서 배우는 LLM — 15주 실습 골든 이미지" \
      org.opencontainers.image.base.name="nvidia/cuda:13.0.1-runtime-ubuntu24.04"

WORKDIR /work
CMD ["/bin/bash"]
