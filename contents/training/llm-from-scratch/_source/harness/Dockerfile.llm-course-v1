# 수업용 골든 이미지 llm-course:v1
#
# 교재 1주차 P1-4가 요구하는 "골든 이미지"의 구현체.
# 대상 환경: NVIDIA DGX Spark (GB10 / Grace Blackwell / aarch64 / CUDA 13 / 통합 메모리 128GB)
#
# 설계 근거:
#  - base: nvidia/cuda:13.0.1-runtime-ubuntu24.04 → 호스트 드라이버 580.x / CUDA 13.0 과 정합
#  - Ubuntu 24.04 의 시스템 python 이 3.12 → torch cu130 cp312 aarch64 휠과 정확히 일치
#  - torch 는 반드시 cu130 인덱스에서 받는다. PyPI 기본 휠은 GB10(sm_121) 커널이 없다.
FROM nvidia/cuda:13.0.1-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev \
        git curl wget ca-certificates \
        build-essential pkg-config \
        vim less procps \
        fonts-nanum fonts-nanum-coding fontconfig \
    && fc-cache -fv \
    && rm -rf /var/lib/apt/lists/*

# 1) torch — CUDA 13.0 전용 인덱스 (aarch64 + sm_121 지원)
RUN pip install --index-url https://download.pytorch.org/whl/cu130 \
        torch==2.9.1+cu130

# 2) 교재 실습 의존성
#    tiktoken   : 2주차 BPE
#    matplotlib : 4·6·9·10·11·13주차 그래프
#    pandas     : 11주차 SMS 스팸 데이터
#    pytest     : 전 주차 성질 테스트
#    jupyter    : 1주차 nbconvert 스모크 테스트
#    requests/tqdm : 10·11·12주차 다운로드
RUN pip install \
        tiktoken \
        matplotlib \
        pandas \
        pytest \
        numpy \
        requests \
        tqdm \
        jupyter nbconvert ipykernel

# 3) matplotlib 한글 라벨이 □ 로 깨지지 않게 기본 폰트를 NanumGothic 으로 고정.
#    (교재의 그래프 미션은 4·6·9·10·11·13주차에 한글 제목·축 라벨을 요구한다)
#    패키지 기본 matplotlibrc 를 수정하면 Duplicate key 경고가 나므로 별도 파일 + MATPLOTLIBRC.
RUN mkdir -p /opt/mplconfig && printf '%s\n' \
        'backend: Agg' \
        'font.family: NanumGothic' \
        'axes.unicode_minus: False' \
        'figure.dpi: 110' \
    > /opt/mplconfig/matplotlibrc
ENV MATPLOTLIBRC=/opt/mplconfig/matplotlibrc \
    MPLCONFIGDIR=/tmp/mplcache

WORKDIR /work
CMD ["/bin/bash"]
